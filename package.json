{
  "name": "github-mcp-agent",
  "version": "1.0.0",
  "description": "MCP Server que expone tools para automatizar operaciones de GitHub (repos, issues, commits) mediante lenguaje natural, integrado con Antigravity.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
